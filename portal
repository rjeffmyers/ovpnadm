def page(body, title="VPN self-service"):
    return ("<!doctype html><html lang=en><head><meta charset=utf-8>"
            "<meta name=viewport content='width=device-width, initial-scale=1'>"
            f"<title>{title}</title><style>{STYLE}</style></head>"
            f"<body><main>{body}</main></body></html>").encode()


def esc(s):
    return html.escape(str(s))


def password_field(name="password", label="Your current password", auto="current-password"):
    return (f"<label for={name}>{label}</label>"
            f"<input type=password id={name} name={name} required autocomplete={auto}>")


def home(ip, message="", ok=True):
    data, err = info(ip)
    if data is None:
        return page(f"<h1>VPN self-service</h1><div class='msg err'>{esc(err)}</div>")
    t = esc(token(ip))
    banner = f"<div class='msg {'ok' if ok else 'err'}'>{esc(message)}</div>" if message else ""
    rows = [("User", data.get("user", "?"))]
    if data.get("client", "-") != "-":
        rows += [("Profile", data["client"]),
                 ("Expires", f"{data.get('expires', '?')} ({data.get('days_left', '?')} days left)"),
                 ("Renews for", f"{data.get('period', '?')} days")]
        if data.get("until", "-") != "-":
            rows.append(("Access until", data["until"]))
    dl = "".join(f"<dt>{esc(k)}</dt><dd>{esc(v)}</dd>" for k, v in rows)

    if data.get("renew") == "yes":
        renew = (f"<p>Get a new profile valid until <b>{esc(data.get('renew_expires'))}</b>. "
                 "Your current profile stops working once you disconnect, so <b>save the new file "
                 "and import it before you disconnect</b>.</p>"
                 f"<form method=post action=/renew><input type=hidden name=token value={t}>"
                 f"{password_field('rp')}<button>Renew and download</button></form>")
    else:
        renew = f"<p>{esc(data.get('renew_reason', 'Renewal is not available.'))}</p>"

    if data.get("passwd") == "yes":
        passwd = (f"<form method=post action=/passwd><input type=hidden name=token value={t}>"
                  f"{password_field('cp')}"
                  f"{password_field('new', 'New password (at least 12 characters)', 'new-password')}"
                  f"{password_field('new2', 'New password again', 'new-password')}"
                  "<button>Change password</button></form>"
                  "<p class=note>This is your VPN login password. Your current connection stays up.</p>")
    else:
        passwd = f"<p>{esc(data.get('passwd_reason', 'Not available.'))}</p>"

    body = (f"<h1>VPN self-service</h1><p class=sub>Connected from {esc(ip)}</p>{banner}"
            f"<section><h2>Your connection</h2><dl>{dl}</dl></section>"
            f"<section><h2>Renew your profile</h2>{renew}</section>"
            f"<section><h2>Download your current profile</h2>"
            f"<p>Get your .ovpn file again, for example for another device or after reinstalling.</p>"
            f"<form method=post action=/profile><input type=hidden name=token value={t}>"
            f"{password_field('dp')}<button>Download</button></form></section>"
            f"<section><h2>Change your password</h2>{passwd}</section>")
    return page(body)


class Handler(BaseHTTPRequestHandler):
    server_version = "ovpnadm-portal"
    sys_version = ""
    timeout = 30

    def log_message(self, fmt, *a):
        log(f"{self.client_address[0]} {fmt % a}")

    def client_ok(self):
        ip = self.client_address[0]
        try:
            if ipaddress.ip_address(ip) in args.pool and ip != args.bind:
                return ip
        except ValueError:
            pass
        self.reply(403, page("<h1>Forbidden</h1><p>This page is only available through the VPN.</p>"))
        return None

    def reply(self, code, body, ctype="text/html; charset=utf-8", extra=None):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Content-Security-Policy",
                         "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        ip = self.client_ok()
        if not ip:
            return
        if self.path != "/":
            self.reply(404, page("<h1>Not found</h1><p><a href=/>Back</a></p>"))
            return
        self.reply(200, home(ip))

    def do_POST(self):
        ip = self.client_ok()
        if not ip:
            return
        action = self.path.strip("/")
        if action not in ("profile", "renew", "passwd"):
            self.reply(404, page("<h1>Not found</h1>"))
            return
        try:
            length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            length = MAX_BODY + 1
        if length > MAX_BODY:
            self.reply(413, page("<h1>Request too large</h1>"))
            return
        form = {k: v[0] for k, v in parse_qs(self.rfile.read(length).decode("utf-8", "replace")).items()}
        if not hmac.compare_digest(form.get("token", ""), token(ip)):
            self.reply(400, home(ip, "The form expired - please try again.", ok=False))
            return
        if locked_out(ip):
            self.reply(429, home(ip, "Too many wrong passwords. Wait 15 minutes and try again.", ok=False))
            return

        pw = {"profile": "dp", "renew": "rp", "passwd": "cp"}[action]
        stdin = form.get(pw, "").replace("\n", "") + "\n"
        if action == "passwd":
            new, new2 = form.get("new", ""), form.get("new2", "")
            if new != new2:
                self.reply(200, home(ip, "The new passwords do not match.", ok=False))
                return
            if "\n" in new or "\r" in new:
                self.reply(200, home(ip, "The new password contains invalid characters.", ok=False))
                return
            stdin += new + "\n"

        status, out, err = adm(action, ip, stdin)
        if status == 3:
            record_failure(ip)
            self.reply(200, home(ip, "Wrong password.", ok=False))
        elif status != 0:
            self.reply(200, home(ip, err or "Something went wrong.", ok=False))
        elif action == "passwd":
            self.reply(200, home(ip, "Your password has been changed. Use it the next time you connect."))
        else:
            data, _ = info(ip)
            name = (data or {}).get("client", "-")
            fname = f"{name if name != '-' else 'vpn'}.ovpn"
            self.reply(200, out.encode(), "application/x-openvpn-profile",
                       {"Content-Disposition": f'attachment; filename="{fname}"'})


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def server_bind(self):
        # IP_FREEBIND: bind even while the tunnel interface does not have the address yet
        self.socket.setsockopt(socket.SOL_IP, getattr(socket, "IP_FREEBIND", 15), 1)
        socketserver.TCPServer.server_bind(self)   # skip HTTPServer's reverse DNS lookup
        self.server_name, self.server_port = self.server_address[:2]


def main():
    global args
    p = argparse.ArgumentParser(description="ovpnadm self-service portal")
    p.add_argument("--bind", required=True, help="VPN server address to listen on (e.g. 10.8.0.1)")
    p.add_argument("--port", type=int, default=8080)
    p.add_argument("--pool", required=True, type=ipaddress.ip_network, help="VPN client network")
    p.add_argument("--adm", default="/usr/sbin/ovpnadm")
    args = p.parse_args()
    log(f"listening on http://{args.bind}:{args.port}/ for clients in {args.pool}")
    Server((args.bind, args.port), Handler).serve_forever()


if __name__ == "__main__":
    main()
