#!/usr/bin/python3
"""ovpnadm self-service portal.

A small web page, reachable only through the VPN, where a connected user can
download their profile, renew their certificate and change their password.

The user is identified by the VPN address their request comes from (OpenVPN
ties it to their session); every action also asks for their current
password. The real work is done by "sudo ovpnadm self ...", which re-checks
the identity itself, so this process runs unprivileged.

Plain HTTP is used on purpose: the page is only reachable through the VPN
tunnel, which already encrypts the traffic.
"""

import argparse
import hashlib
import hmac
import html
import ipaddress
import secrets
import socket
import socketserver
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs

FAIL_LIMIT = 5          # wrong passwords ...
FAIL_WINDOW = 15 * 60   # ... within this many seconds lock the address out
MAX_BODY = 4096

SECRET = secrets.token_bytes(32)
failures = {}
failures_lock = threading.Lock()
args = None


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def adm(cmd, ip, stdin=""):
    """Run "ovpnadm self <cmd> <ip>"; returns (status, stdout, error message)."""
    try:
        r = subprocess.run(["sudo", "-n", args.adm, "self", cmd, ip], input=stdin,
                           capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        return 1, "", "the server took too long - try again"
    err = r.stderr.strip().splitlines()
    err = err[-1].removeprefix("ovpnadm: ") if err else ""
    return r.returncode, r.stdout, err


def info(ip):
    status, out, err = adm("info", ip)
    if status != 0:
        return None, err
    return dict(line.split("=", 1) for line in out.splitlines() if "=" in line), ""


def token(ip):
    return hmac.new(SECRET, ip.encode(), hashlib.sha256).hexdigest()[:32]


def locked_out(ip):
    now = time.time()
    with failures_lock:
        recent = [t for t in failures.get(ip, []) if now - t < FAIL_WINDOW]
        failures[ip] = recent
        return len(recent) >= FAIL_LIMIT


def record_failure(ip):
    with failures_lock:
        failures.setdefault(ip, []).append(time.time())


