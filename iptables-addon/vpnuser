#!/bin/bash
#
# vpnuser - manage VPN-only accounts and what each one may reach
#
#   vpnuser list                            accounts in access.txt and their access
#   vpnuser add <user> <hosts> [<ports>]    create the account and its access line
#   vpnuser set <user> <hosts> [<ports>]    change what an existing user may reach
#   vpnuser passwd <user>                   give the user a new random password
#   vpnuser del <user>                      remove the access line and the account
#
#   <hosts>  lan (the whole LAN), or host/network list: 192.168.1.106,192.168.1.64/26
#   <ports>  all (default), or a list: 3389/tcp,3389/udp
#
# Examples:
#   vpnuser add jane.doe lan                               full LAN access
#   vpnuser add john.roe 192.168.1.120 3389/tcp,3389/udp   RDP to one desktop
#
# New passwords are shown on screen and kept in /root/vpn-passwords.txt
# (root only). Changes take effect at the user's next connection, except that
# removed access is blocked at once.

LAN=192.168.1.0/24         # what "lan" means; set LAN in the file below
# shellcheck source=/dev/null
[[ -r ${RC_OPENVPN_CONF:-/etc/firewall/rc.openvpn.conf} ]] && . "${RC_OPENVPN_CONF:-/etc/firewall/rc.openvpn.conf}"
ACCESS=${ACCESS:-/etc/openvpn/server/access.txt}
RC=${RC:-/etc/firewall/rc.openvpn}
GROUP=vpnusers
PWFILE=${PWFILE:-/root/vpn-passwords.txt}

die() { echo "vpnuser: $*" >&2; exit 1; }
usage() { sed -n '3,21s/^# \{0,1\}//p' "$0"; exit 1; }

[[ ${1:-} =~ ^(list|add|set|passwd|del)$ ]] || usage
[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"
[[ -f $ACCESS ]] || die "$ACCESS not found"

entry() { awk -v u="$1" '$1 == u' "$ACCESS"; }

check_user() {
  [[ $1 =~ ^[a-z_][a-z0-9_.-]{0,31}$ ]] || die "bad user name '$1' (lower case letters, digits, . _ -)"
}

# Fills HOSTS and PORTS from the command line, checked by rc.openvpn's own rules
access_args() {
  [[ -n ${1:-} ]] || usage
  HOSTS=$1; PORTS=${2:-all}
  [[ $HOSTS == lan ]] && HOSTS=$LAN
  local h p
  for h in ${HOSTS//,/ }; do
    [[ $h =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$ ]] || die "bad host or network '$h'"
  done
  if [[ $PORTS != all ]]; then
    for p in ${PORTS//,/ }; do
      [[ $p =~ ^[0-9]{1,5}(-[0-9]{1,5})?/(tcp|udp)$ ]] || die "bad port '$p' (e.g. 3389/tcp)"
    done
  fi
}

new_password() {
  local pw
  pw=$(tr -dc 'A-HJ-NP-Za-km-z2-9' </dev/urandom | head -c 20 || true)
  printf '%s:%s\n' "$1" "$pw" | chpasswd || die "could not set the password"
  ( umask 077; printf '%s  %-24s %s\n' "$(date '+%F %R')" "$1" "$pw" >> "$PWFILE" )
  if [[ -t 1 ]]; then
    echo "password for $1: $pw"
  else
    echo "password for $1 saved in $PWFILE"
  fi
}

# Rewrite access.txt with the user's line replaced (or removed when $2 is empty)
write_line() {
  local tmp
  cp -p "$ACCESS" "$ACCESS.vpnuser-prev" || die "could not back up $ACCESS"
  tmp=$(mktemp "$ACCESS.XXXXXX") || die "could not write $ACCESS"
  awk -v u="$1" -v l="$2" '$1 == u { if (l != "") print l; done = 1; next } { print }
    END { if (!done && l != "") print l }' "$ACCESS" > "$tmp"
  chmod 600 "$tmp"; mv "$tmp" "$ACCESS"
}

# Run rc.openvpn. If it rejects the user's new line, put access.txt back
# (and remove the account when $2 says we just created it).
apply() {
  local out
  out=$("$RC" 2>&1)
  if [[ $out == *" $1 "* ]]; then
    echo "$out" >&2
    cp -p "$ACCESS.vpnuser-prev" "$ACCESS"
    [[ ${2:-} == new ]] && userdel "$1"
    "$RC" >/dev/null 2>&1
    die "rc.openvpn rejected the line for $1 - nothing was changed"
  fi
  [[ -n $out ]] && echo "$out" >&2
  rm -f "$ACCESS.vpnuser-prev"
  return 0
}

cmd=${1:-}; shift || true
case $cmd in
  list)
    printf '%-24s %-4s %-7s %-32s %s\n' USER N ACCOUNT HOSTS PORTS
    grep -vE '^[[:space:]]*(#|$)' "$ACCESS" | while read -r u n h p _; do
      if ! id "$u" >/dev/null 2>&1; then a=missing
      elif passwd -S "$u" 2>/dev/null | awk '{exit $2 != "L"}'; then a=locked
      else a=ok; fi
      printf '%-24s %-4s %-7s %-32s %s\n' "$u" "$n" "$a" "$h" "$p"
    done ;;

  add)
    [[ -n ${1:-} ]] || usage
    user=$1; shift; check_user "$user"; access_args "$@"
    [[ -z $(entry "$user") ]] || die "$user is already in $ACCESS (use: vpnuser set)"
    if id "$user" >/dev/null 2>&1; then
      id -nG "$user" | grep -qw "$GROUP" || die "$user exists but is not a VPN account (not in $GROUP)"
      echo "account $user already exists; keeping its password"
      newpw=old
    else
      useradd -M -s /usr/sbin/nologin -G "$GROUP" "$user" || die "could not create $user"
      newpw=new
    fi
    used=" $(grep -vE '^[[:space:]]*(#|$)' "$ACCESS" | awk '{printf "%s ", $2}')"
    for n in $(seq 10 250); do [[ $used == *" $n "* ]] || break; done
    [[ $used == *" $n "* ]] && die "no free number left (10-250)"
    write_line "$user" "$(printf '%-20s %-3s %-15s %s' "$user" "$n" "$HOSTS" "$PORTS")"
    apply "$user" $newpw
    [[ $newpw == new ]] && new_password "$user"
    echo "added $user: VPN address 172.30.98.$n / 172.30.99.$n, may reach $HOSTS ports $PORTS" ;;

  set)
    [[ -n ${1:-} ]] || usage
    user=$1; shift; access_args "$@"
    line=$(entry "$user"); [[ -n $line ]] || die "$user is not in $ACCESS (use: vpnuser add)"
    n=$(awk '{print $2}' <<< "$line")
    write_line "$user" "$(printf '%-20s %-3s %-15s %s' "$user" "$n" "$HOSTS" "$PORTS")"
    apply "$user"
    echo "$user may now reach $HOSTS ports $PORTS (from the next connection)" ;;

  passwd)
    [[ -n ${1:-} ]] || usage
    id "$1" >/dev/null 2>&1 || die "no account $1"
    id -nG "$1" | grep -qw "$GROUP" || die "$1 is not a VPN account (not in $GROUP)"
    new_password "$1" ;;

  del)
    [[ -n ${1:-} ]] || usage
    user=$1
    [[ -n $(entry "$user") ]] && { write_line "$user" ""; apply "$user"; echo "removed $user from $ACCESS"; }
    if id "$user" >/dev/null 2>&1; then
      id -nG "$user" | grep -qw "$GROUP" || die "$user is not a VPN account (not in $GROUP); account left alone"
      userdel "$user" && echo "deleted account $user"
    fi ;;

  *) usage ;;
esac
